{
  "name": "tsheets-mcp",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "NODE_OPTIONS=--use-system-ca tsx watch src/index.ts",
    "start": "NODE_OPTIONS=--use-system-ca node dist/index.js",
    "auth": "NODE_OPTIONS=--use-system-ca tsx scripts/auth-tsheets.ts",
    "test:tsheets": "NODE_OPTIONS=--use-system-ca tsx scripts/test-tsheets.ts",
    "test": "NODE_OPTIONS=--use-system-ca vitest",
    "test:run": "NODE_OPTIONS=--use-system-ca vitest run",
    "test:coverage": "NODE_OPTIONS=--use-system-ca vitest run --coverage",
    "test:watch": "NODE_OPTIONS=--use-system-ca vitest watch",
    "db:sync-history": "NODE_OPTIONS=--use-system-ca node --input-type=module -e \"import('./dist/db/sync.js').then(m => m.syncAllHistory())\"",
    "db:sync-recent": "NODE_OPTIONS=--use-system-ca node --input-type=module -e \"import('./dist/db/sync.js').then(m => m.syncRecentData())\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cykj40/Tsheets-MCP.git"
  },
  "keywords": [
    "mcp",
    "tsheets",
    "sage",
    "timesheet"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cykj40/Tsheets-MCP/issues"
  },
  "homepage": "https://github.com/cykj40/Tsheets-MCP#readme",
  "description": "MCP server for TSheets to Sage 100 Contractor timesheet automation",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "node-fetch": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/node-fetch": "^2.6.12",
    "@vitest/coverage-v8": "^4.1.8",
    "msw": "^2.12.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
